#!/bin/sh

# Copyright 2026 Brannen Hall. All rights reserved.

# Tests scripts/check-attribution on commits in a throwaway repository.
#
#   scripts/test-check-attribution

set -eu

check="$(cd "$(dirname "$0")" && pwd)/check-attribution"
repo="$(mktemp -d)"
trap 'rm -rf "$repo"' EXIT
cd "$repo"

maintainer='Mariana Okafor <mariana.okafor@fastmail.com>'

commit() {
    # commit <author> <committer> <message>
    GIT_AUTHOR_NAME="${1% <*}" GIT_AUTHOR_EMAIL="$(echo "$1" | sed 's/.*<\(.*\)>/\1/')" \
    GIT_COMMITTER_NAME="${2% <*}" GIT_COMMITTER_EMAIL="$(echo "$2" | sed 's/.*<\(.*\)>/\1/')" \
        git -c commit.gpgsign=false commit -q --allow-empty -m "$3"
}

git init -q
commit "$maintainer" "$maintainer" "Record the March rent for the Elm Street flat"
git tag base

failures=0
run() {
    # run pass|fail <name> <author> <committer> <message> [<title> [<body>]]
    git checkout -q --detach base
    commit "$3" "$4" "$5"
    if PR_TITLE="${6:-}" PR_BODY="${7:-}" "$check" base HEAD 2>/dev/null; then
        got=pass
    else
        got=fail
    fi
    if [ "$got" != "$1" ]; then
        echo "FAIL: $2: expected $1, got $got" >&2
        failures=$((failures + 1))
    fi
}

human() { run "$1" "$2" "$maintainer" "$maintainer" "$3" "${4:-}" "${5:-}"; }
author() { run fail "$1" "$2" "$maintainer" "Split the grocery run with Priya"; }

human pass "plain commit" "Reconcile the checking account for February"
human pass "message names tools without crediting them" \
    "Mention CLAUDE.md, Copilot and Codex in the contributing notes"
human pass "human co-author" \
    "Net the dinner bill

Co-authored-by: Priya Raman <priya.raman@posteo.net>"
run pass "human named Devin" "Devin Castellanos <devin.castellanos@proton.me>" \
    "$maintainer" "Pay the Visa card from savings"
run pass "human named Jules" "Jules Moreau <jules@moreau.family>" \
    "$maintainer" "Add the October payroll deposit"
human pass "clean pull request" "Move the budget notes" \
    "Move the budget notes" "Keeps the notes beside the other docs."

author "Claude" "Claude <noreply@anthropic.com>"
author "Claude Code" "Claude Code <noreply@anthropic.com>"
author "Codex" "Codex <codex@openai.com>"
author "ChatGPT Codex connector" \
    "chatgpt-codex-connector[bot] <199175422+chatgpt-codex-connector[bot]@users.noreply.github.com>"
author "Copilot agent" \
    "copilot-swe-agent[bot] <198982749+Copilot@users.noreply.github.com>"
author "Cursor agent" "Cursor Agent <cursoragent@cursor.com>"
author "Aider" "Mariana Okafor (aider) <mariana.okafor@fastmail.com>"
author "Devin" \
    "devin-ai-integration[bot] <158243242+devin-ai-integration[bot]@users.noreply.github.com>"
author "Jules" \
    "google-labs-jules[bot] <161369871+google-labs-jules[bot]@users.noreply.github.com>"
author "Windsurf" "Windsurf <cascade@windsurf.com>"
author "OpenHands" "openhands <openhands@all-hands.dev>"
run fail "agent committer" "$maintainer" "Claude <noreply@anthropic.com>" \
    "Close out the 2025 books"

human fail "Claude co-author" "Fix the card reserve

Co-authored-by: Claude <noreply@anthropic.com>"
human fail "Copilot co-author" "Fix the card reserve

Co-authored-by: Copilot <175728472+Copilot@users.noreply.github.com>"
human fail "Aider co-author" "Fix the card reserve

Co-authored-by: aider (gpt-4o) <noreply@aider.chat>"
human fail "Amp co-author" "Fix the card reserve

Co-authored-by: Amp <amp@ampcode.com>"
human fail "Cursor co-author" "Fix the card reserve

Co-authored-by: Cursor Agent <cursoragent@cursor.com>"
human fail "Claude session trailer" "Fix the card reserve

Claude-Session: https://claude.ai/code/session_01HxQ3vV7mWkzZ8RbT2nYp4L"
human fail "Amp thread trailer" "Fix the card reserve

Amp-Thread-ID: https://ampcode.com/threads/T-5f1c9a2e-7b3d-4e8a-9c61-2d0f4b8e7a13"
human fail "generated-with line" "Fix the card reserve

🤖 Generated with [Claude Code](https://claude.ai/code)"
human fail "created-with line" "Fix the card reserve

Created with Cursor"

human fail "title credits Claude" "Add the loans page" "Created with Claude Code"
human fail "Codex task link" "Add the loans page" "Add the loans page" \
    "Codex Task: https://chatgpt.com/codex/tasks/task_e_68f2a91c3d4c8331a7e5b0d2f6c4"
human fail "Devin run link" "Add the loans page" "Add the loans page" \
    "Link to Devin run: https://app.devin.ai/sessions/4be1c7d29a0e4f3b8c6d5e2a1f907b34"
human fail "Copilot written-by line" "Add the loans page" "Add the loans page" \
    "Written by GitHub Copilot"
human fail "Gemini generated-by line" "Add the loans page" "Add the loans page" \
    "Generated by Gemini"

if [ "$failures" -ne 0 ]; then
    echo "$failures case(s) failed" >&2
    exit 1
fi
echo "check-attribution: all cases pass"
